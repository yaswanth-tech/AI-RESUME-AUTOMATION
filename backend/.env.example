# Copy to backend/.env and supply private values locally.
PORT=3002
CORS_ORIGINS="http://localhost:3002"
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require"
DB_CONNECTION_LIMIT=5
DB_POOL_MODE=transaction
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# AI is off until a provider account and data handling have been approved.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=""
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=12000
AI_CACHE_TTL_SECONDS=86400
AI_INPUT_COST_PER_MILLION=0.10
AI_OUTPUT_COST_PER_MILLION=0.50
RESUME_STORAGE_DIR=""
OCR_LANGUAGES=eng
# Point to locally provisioned Tesseract trained data for offline OCR.
TESSDATA_DIR=""
